# ── Demo mode ─────────────────────────────────────────────
# Set to true to run with mock data (no wallet/contracts needed)
# Set to false once contracts are deployed
VITE_DEMO_MODE=true

# ── WalletConnect ──────────────────────────────────────────
# Get free project ID at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ── Contract addresses ─────────────────────────────────────
# Paste the output from: cd contracts && npm run deploy:demo
VITE_WILL_REGISTRY=
VITE_TRIGGER_VERIFIER=
VITE_ASSET_DISTRIBUTOR=

# ── Chain ──────────────────────────────────────────────────
VITE_CHAIN_ID=80002
